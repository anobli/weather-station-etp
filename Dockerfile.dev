# syntax=docker/dockerfile:1.7
#
# tempest-etp dev/test container — this project's Python toolchain + Claude
# Code, for running and poking at the app in an isolated sandbox.
#
# Build:
#   docker compose --profile dev build dev
#
# Run:
#   docker compose --profile dev run --rm dev
#
# Design notes:
#   - The repo is bind-mounted at runtime (image stays generic); see the
#     `dev` service in docker-compose.yml.
#   - Claude Code is installed globally via npm; its auth/state lives in
#     ~/.claude, bind-mounted from the host at run time.
#   - requirements-dev.txt layers pytest/httpx on top of the app's own
#     requirements.txt, for exercising the FastAPI app without a live server.

FROM python:3.12-slim

ARG NODE_MAJOR=22
ARG USERNAME=dev
ARG USER_UID=1000
ARG USER_GID=1000

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# --- 1. OS packages ----------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates gnupg sudo \
        sqlite3 jq ripgrep less vim-tiny \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

# --- 2. Node.js + Claude Code -------------------------------------------
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g @anthropic-ai/claude-code \
    && npm cache clean --force

# --- 3. Python deps (app + test tools) ----------------------------------
WORKDIR /app
COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt

# --- 4. Non-root user matching host UID/GID -----------------------------
RUN set -eux; \
    if getent group ${USER_GID} >/dev/null; then \
        groupmod -n ${USERNAME} "$(getent group ${USER_GID} | cut -d: -f1)"; \
    else \
        groupadd --gid ${USER_GID} ${USERNAME}; \
    fi; \
    useradd --uid ${USER_UID} --gid ${USER_GID} -m -s /bin/bash ${USERNAME}; \
    echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME}; \
    chmod 0440 /etc/sudoers.d/${USERNAME}; \
    chown -R ${USER_UID}:${USER_GID} /app

COPY docker/dev-entrypoint.sh /usr/local/bin/dev-entrypoint.sh
RUN chmod +x /usr/local/bin/dev-entrypoint.sh

USER ${USERNAME}
WORKDIR /app

ENTRYPOINT ["/usr/local/bin/dev-entrypoint.sh"]
CMD ["bash"]
